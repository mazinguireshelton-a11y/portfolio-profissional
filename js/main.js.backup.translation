// Inject project styles
const projectStyleSheet = document.createElement('style');
projectStyleSheet.textContent = projectStyles;
document.head.appendChild(projectStyleSheet);

// js/main.js - ADICIONE ESTE CÓDIGO
document.addEventListener('DOMContentLoaded', function() {
    console.log('🚀 Inicializando aplicação completa...');
    
    // Garantir que o sistema de tradução esteja funcionando
    if (!window.completeTranslationSystem) {
        console.log('🔄 Reinicializando sistema de tradução...');
        window.completeTranslationSystem = new CompleteTranslationSystem();
    }
    
    // Verificar se estamos em mobile
    if (window.innerWidth <= 768) {
        console.log('📱 Modo mobile detectado - otimizando traduções...');
        document.body.classList.add('mobile-mode');
    }
    
    // Adicionar listener para mudanças de orientação
    window.addEventListener('orientationchange', function() {
        setTimeout(() => {
            if (window.completeTranslationSystem) {
                window.completeTranslationSystem.applyTranslations();
            }
        }, 300);
    });
});
