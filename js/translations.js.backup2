// ✅ INICIALIZAÇÃO SEGURA - PREVINE DUPLICAÇÃO
let translationSystem = null;

function initializeTranslationSystem() {
    if (!translationSystem) {
        console.log('🌍 Criando nova instância do sistema de tradução...');
        translationSystem = new UnifiedTranslationSystem();
        window.translationSystem = translationSystem;
        window.UnifiedTranslationSystem = UnifiedTranslationSystem; // Para debug
    }
    return translationSystem;
}

// Inicialização robusta
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
        console.log('📄 DOM Carregado - Iniciando sistema de tradução...');
        initializeTranslationSystem();
    });
} else {
    console.log('⚡ DOM já carregado - Iniciando sistema de tradução...');
    setTimeout(() => initializeTranslationSystem(), 100);
}

// Fallback para garantir funcionamento
window.addEventListener('load', function() {
    console.log('🔄 Window carregado - Verificando sistema de tradução...');
    if (!translationSystem || !translationSystem.isInitialized) {
        console.log('🔄 Reinicializando sistema de tradução...');
        initializeTranslationSystem();
    }
});

console.log('🎯 Sistema de tradução unificado carregado e pronto!');
