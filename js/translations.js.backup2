// js/translations.js - SISTEMA COMPLETO CORRIGIDO E OTIMIZADO
console.log('🌍 SISTEMA DE TRADUÇÃO UNIFICADO INICIADO!');

class UnifiedTranslationSystem {
    constructor() {
        this.currentLang = this.detectLanguage();
        this.translations = this.getCompleteTranslations();
        this.isInitialized = false;
        this.isTranslating = false;
        this.init();
    }

    init() {
        if (this.isInitialized) {
            console.log('⚠️ Sistema já inicializado, ignorando...');
            return;
        }
        
        console.log('🚀 Iniciando sistema de tradução unificado...');
        this.setupLanguageSelector();
        this.applyTranslations();
        this.updateLanguageButton();
        this.setupEventListeners();
        this.setupMutationObserver();
        
        this.isInitialized = true;
        console.log('✅ Sistema unificado inicializado! Idioma:', this.currentLang);
    }

    detectLanguage() {
        const savedLang = localStorage.getItem('preferredLanguage');
        if (savedLang && this.translations[savedLang]) {
            console.log('💾 Idioma salvo encontrado:', savedLang);
            return savedLang;
        }

        const urlParams = new URLSearchParams(window.location.search);
        const urlLang = urlParams.get('lang');
        if (urlLang && this.translations[urlLang]) {
            console.log('🔗 Idioma da URL:', urlLang);
            return urlLang;
        }

        const browserLang = navigator.language.split('-')[0];
        const supportedLangs = ['pt', 'en', 'es', 'ru', 'zh'];
        const detectedLang = supportedLangs.includes(browserLang) ? browserLang : 'pt';
        
        console.log('🌐 Idioma do navegador detectado:', browserLang, '-> Usando:', detectedLang);
        return detectedLang;
    }

    setupLanguageSelector() {
        const langBtn = document.querySelector('.lang-btn');
        const dropdown = document.querySelector('.lang-dropdown');
        
        if (langBtn && dropdown) {
            // Remover event listeners antigos para evitar duplicação
            const newLangBtn = langBtn.cloneNode(true);
            const newDropdown = dropdown.cloneNode(true);
            langBtn.parentNode.replaceChild(newLangBtn, langBtn);
            dropdown.parentNode.replaceChild(newDropdown, dropdown);

            newLangBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                e.preventDefault();
                newDropdown.classList.toggle('show');
            });

            document.addEventListener('click', (e) => {
                if (!newLangBtn.contains(e.target) && !newDropdown.contains(e.target)) {
                    newDropdown.classList.remove('show');
                }
            });

            newDropdown.querySelectorAll('.lang-option').forEach(option => {
                option.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    const lang = option.getAttribute('data-lang');
                    console.log('🔄 Idioma selecionado:', lang);
                    this.changeLanguage(lang);
                    newDropdown.classList.remove('show');
                });
            });

            console.log('✅ Seletor de idiomas configurado');
        } else {
            console.warn('⚠️ Elementos do seletor de idioma não encontrados');
        }
    }

    setupMutationObserver() {
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'childList') {
                    mutation.addedNodes.forEach((node) => {
                        if (node.nodeType === 1) {
                            this.translateElement(node);
                            node.querySelectorAll('[data-key]').forEach(child => {
                                this.translateElement(child);
                            });
                        }
                    });
                }
            });
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });

        console.log('🔍 Observer de mutação configurado');
    }

    setupEventListeners() {
        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) {
                setTimeout(() => this.applyTranslations(), 100);
            }
        });

        window.addEventListener('resize', () => {
            setTimeout(() => this.applyTranslations(), 50);
        });

        window.addEventListener('languageChanged', (e) => {
            console.log('🎊 Idioma alterado para:', e.detail.language);
        });
    }

    async changeLanguage(lang) {
        if (this.translations[lang] && lang !== this.currentLang && !this.isTranslating) {
            this.isTranslating = true;
            console.log(`🔄 Alterando idioma para: ${lang}`);
            
            document.body.classList.add('language-changing');
            
            this.currentLang = lang;
            localStorage.setItem('preferredLanguage', lang);
            
            await new Promise(resolve => setTimeout(resolve, 50));
            
            this.applyTranslations();
            this.updateLanguageButton();
            
            setTimeout(() => {
                document.body.classList.remove('language-changing');
                this.isTranslating = false;
            }, 300);
            
            window.dispatchEvent(new CustomEvent('languageChanged', { 
                detail: { language: lang } 
            }));
        }
    }

    applyTranslations() {
        console.log(`🔄 Aplicando traduções para: ${this.currentLang}`);
        
        try {
            // 1. Atualizar atributo lang do HTML
            document.documentElement.lang = this.currentLang;
            
            // 2. Traduzir TODOS os elementos com data-key
            this.translateAllDataKeyElements();
            
            // 3. Traduzir meta tags
            this.translateMetaTags();
            
            // 4. Traduzir conteúdo dinâmico
            this.translateDynamicContent();
            
            // 5. Traduzir textos hardcoded (fallback)
            this.translateHardcodedTexts();
            
            console.log('✅ Todas as traduções aplicadas!');
        } catch (error) {
            console.error('❌ Erro na tradução:', error);
            this.isTranslating = false;
        }
    }

    translateAllDataKeyElements() {
        const elements = document.querySelectorAll('[data-key]');
        console.log(`📝 Traduzindo ${elements.length} elementos com data-key`);
        
        elements.forEach(element => {
            this.translateElement(element);
        });
    }

    translateElement(element) {
        if (!element.hasAttribute('data-key')) return;
        
        const key = element.getAttribute('data-key');
        const translation = this.getTranslation(key);
        
        if (translation && translation !== key) {
            const tagName = element.tagName.toLowerCase();
            
            if (tagName === 'input' || tagName === 'textarea') {
                element.placeholder = translation;
            } else if (tagName === 'img' && element.hasAttribute('alt')) {
                element.alt = translation;
            } else if (element.hasAttribute('title')) {
                element.title = translation;
            } else if (element.hasAttribute('aria-label')) {
                element.setAttribute('aria-label', translation);
            } else {
                element.textContent = translation;
            }
            
            element.setAttribute('data-translated', 'true');
        }
    }

    translateMetaTags() {
        const title = this.getTranslation('site.title');
        if (title) {
            document.title = title;
        }

        const description = this.getTranslation('site.description');
        const metaDescription = document.querySelector('meta[name="description"]');
        if (description && metaDescription) {
            metaDescription.setAttribute('content', description);
        }
    }

    translateDynamicContent() {
        // Traduzir galeria
        this.translateGallery();
        
        // Traduzir projetos
        this.translateProjects();
        
        // Traduzir certificados
        this.translateCertificates();
        
        // Traduzir cursos
        this.translateCourses();
        
        // Traduzir esportes
        this.translateSports();
    }

    translateGallery() {
        const galleryTitles = {
            'pt': '📸 Galeria Young Life',
            'en': '📸 Young Life Gallery', 
            'es': '📸 Galería Young Life',
            'ru': '📸 Галерея Young Life',
            'zh': '📸 Young Life 画廊'
        };

        const galleryElements = document.querySelectorAll('#youngLifeGallery h2, .gallery-header h2');
        galleryElements.forEach(el => {
            if (galleryTitles[this.currentLang]) {
                el.textContent = galleryTitles[this.currentLang];
            }
        });

        // Traduzir categorias da galeria
        this.translateGalleryCategories();
    }

    translateGalleryCategories() {
        const categories = {
            'todos': { 'pt': '📸 Todas as Fotos', 'en': '📸 All Photos', 'es': '📸 Todas las Fotos', 'ru': '📸 Все Фото', 'zh': '📸 所有照片' },
            'clube-jovens': { 'pt': '👥 Clube de Jovens', 'en': '👥 Youth Club', 'es': '👥 Club de Jóvenes', 'ru': '👥 Молодежный Клуб', 'zh': '👥 青年俱乐部' },
            'acampamento1': { 'pt': '🏕️ Acampamento 1', 'en': '🏕️ Camp 1', 'es': '🏕️ Campamento 1', 'ru': '🏕️ Лагерь 1', 'zh': '🏕️ 营地 1' },
            'acampamento2': { 'pt': '🏕️ Acampamento 2', 'en': '🏕️ Camp 2', 'es': '🏕️ Campamento 2', 'ru': '🏕️ Лагерь 2', 'zh': '🏕️ 营地 2' },
            'graduacao': { 'pt': '🎓 Graduação', 'en': '🎓 Graduation', 'es': '🎓 Graduación', 'ru': '🎓 Выпускной', 'zh': '🎓 毕业' }
        };

        document.querySelectorAll('.category-card').forEach(card => {
            const categoryId = card.getAttribute('onclick')?.match(/'([^']+)'/)?.[1];
            if (categoryId && categories[categoryId]) {
                const categoryName = categories[categoryId][this.currentLang] || categories[categoryId]['pt'];
                const h3 = card.querySelector('h3');
                if (h3) h3.textContent = categoryName;
            }
        });
    }

    translateProjects() {
        const projectElements = document.querySelectorAll('.projeto-card h4');
        const projectTranslations = this.getTranslation('projects') || {};
        
        projectElements.forEach((element, index) => {
            const translation = projectTranslations[index];
            if (translation && translation.name) {
                element.textContent = translation.name;
            }
        });
    }

    translateCertificates() {
        const certificateElements = document.querySelectorAll('.certificado-card h4');
        const certificateTranslations = this.getTranslation('certificates') || {};
        
        certificateElements.forEach((element, index) => {
            const translation = certificateTranslations[index];
            if (translation && translation.name) {
                element.textContent = translation.name;
            }
        });
    }

    translateCourses() {
        console.log('📚 Atualizando traduções de cursos...');
        // Os cursos já são gerenciados pelo CourseManager
    }

    translateSports() {
        const sportsStats = this.getTranslation('sports.stats') || {};
        if (sportsStats.years) {
            const yearsLabel = document.querySelector('[data-key="sports.years"]');
            if (yearsLabel) yearsLabel.textContent = sportsStats.years;
        }
        
        if (sportsStats.games) {
            const gamesLabel = document.querySelector('[data-key="sports.games"]');
            if (gamesLabel) gamesLabel.textContent = sportsStats.games;
        }
        
        if (sportsStats.awards) {
            const awardsLabel = document.querySelector('[data-key="sports.awards"]');
            if (awardsLabel) awardsLabel.textContent = sportsStats.awards;
        }
    }

    translateHardcodedTexts() {
        const elementsToTranslate = [
            { selector: '.skill-item span:nth-child(2)', keys: 'about.skillsList' },
            { selector: '.goals-card li', keys: 'about.goalsList' },
            { selector: '.education-item li', keys: 'about.educationList' },
            { selector: '.esportes-beneficios li', keys: 'sports.benefitsList' }
        ];

        elementsToTranslate.forEach(({ selector, keys }) => {
            const elements = document.querySelectorAll(selector);
            const translations = this.getTranslation(keys) || [];
            
            elements.forEach((element, index) => {
                if (translations[index]) {
                    element.textContent = translations[index];
                }
            });
        });
    }

    getTranslation(key) {
        try {
            const keys = key.split('.');
            let value = this.translations[this.currentLang];
            
            for (const k of keys) {
                value = value ? value[k] : undefined;
                if (!value) break;
            }
            
            // Fallback para português
            if (!value && this.currentLang !== 'pt') {
                value = this.translations['pt'];
                for (const k of keys) {
                    value = value ? value[k] : undefined;
                    if (!value) break;
                }
            }
            
            return value || key;
        } catch (error) {
            console.warn(`⚠️ Erro ao buscar tradução para: ${key}`, error);
            return key;
        }
    }

    updateLanguageButton() {
        const langBtn = document.querySelector('.lang-btn');
        if (!langBtn) return;

        const flags = { 
            'pt': '🇵🇹', 
            'en': '🇺🇸', 
            'es': '🇪🇸', 
            'ru': '🇷🇺', 
            'zh': '🇨🇳' 
        };
        const names = { 
            'pt': 'PT', 
            'en': 'EN', 
            'es': 'ES', 
            'ru': 'RU', 
            'zh': '中文' 
        };
        
        langBtn.innerHTML = `${flags[this.currentLang]} ${names[this.currentLang]}`;
        langBtn.setAttribute('data-lang', this.currentLang);
        
        console.log('✅ Botão de idioma atualizado:', this.currentLang);
    }

